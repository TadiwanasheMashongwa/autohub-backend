{
  "info": {
    "name": "AutoHub - 100% Endpoint Audit (46 Total)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    { "name": "01. order-controller", "item": [
      { "name": "GET /api/v1/orders/{id}", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/orders/1" } },
      { "name": "PATCH /api/v1/orders/{id}/status", "request": { "method": "PATCH", "url": "http://localhost:8080/api/v1/orders/1/status?status=PROCESSING" } },
      { "name": "GET /api/v1/orders/my-orders", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/orders/my-orders" } },
      { "name": "GET /api/v1/orders/all", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/orders/all" } },
      { "name": "POST /api/v1/orders/checkout", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"shippingAddress\": \"Harare, ZW\", \"paymentMethod\": \"PAYNOW\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/orders/checkout" } },
      { "name": "POST /api/v1/orders/cancel/{id}", "request": { "method": "POST", "url": "http://localhost:8080/api/v1/orders/cancel/1" } }
    ]},
    { "name": "02. cart-controller", "item": [
      { "name": "GET /api/v1/cart", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/cart" } },
      { "name": "POST /api/v1/cart/add", "request": { "method": "POST", "url": "http://localhost:8080/api/v1/cart/add?partId=1&quantity=1" } },
      { "name": "DELETE /api/v1/cart/item/{id}", "request": { "method": "DELETE", "url": "http://localhost:8080/api/v1/cart/item/1" } },
      { "name": "DELETE /api/v1/cart/clear", "request": { "method": "DELETE", "url": "http://localhost:8080/api/v1/cart/clear" } }
    ]},
    { "name": "03. authentication-controller", "item": [
      { "name": "POST /api/v1/auth/verify-mfa", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"username\":\"admin\", \"code\":\"123456\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/auth/verify-mfa" } },
      { "name": "POST /api/v1/auth/register", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"username\":\"user1\", \"password\":\"pass123\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/auth/register" } },
      { "name": "POST /api/v1/auth/logout", "request": { "method": "POST", "url": "http://localhost:8080/api/v1/auth/logout" } },
      { "name": "POST /api/v1/auth/login", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"username\":\"admin@autohub.co.zw\", \"password\":\"password\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/auth/login" } }
    ]},
    { "name": "04. admin-controller", "item": [
      { "name": "GET /api/v1/admin/stats", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/admin/stats" } },
      { "name": "GET /api/v1/admin/low-stock", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/admin/low-stock" } },
      { "name": "GET /api/v1/admin/customers", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/admin/customers" } },
      { "name": "PATCH /api/v1/admin/inventory/{partId}/stock", "request": { "method": "PATCH", "url": "http://localhost:8080/api/v1/admin/inventory/1/stock?quantity=100" } },
      { "name": "POST /api/v1/admin/orders/{orderId}/ship", "request": { "method": "POST", "url": "http://localhost:8080/api/v1/admin/orders/1/ship" } },
      { "name": "POST /api/v1/admin/orders/{orderId}/refund", "request": { "method": "POST", "url": "http://localhost:8080/api/v1/admin/orders/1/refund" } }
    ]},
    { "name": "05. password-reset-controller", "item": [
      { "name": "POST /api/v1/auth/reset-password", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"token\":\"abc\", \"newPassword\":\"newpass\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/auth/reset-password" } },
      { "name": "POST /api/v1/auth/forgot-password", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"email\":\"test@test.com\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/auth/forgot-password" } }
    ]},
    { "name": "06. health-controller", "item": [
      { "name": "GET /api/v1/health", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/health" } }
    ]},
    { "name": "07. vehicle-controller", "item": [
      { "name": "GET /api/v1/vehicles", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/vehicles" } },
      { "name": "POST /api/v1/vehicles", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"make\":\"Toyota\", \"model\":\"Hilux\", \"year\":2024}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/vehicles" } },
      { "name": "GET /api/v1/vehicles/years", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/vehicles/years" } },
      { "name": "GET /api/v1/vehicles/models", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/vehicles/models?make=Toyota" } },
      { "name": "GET /api/v1/vehicles/makes", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/vehicles/makes" } },
      { "name": "DELETE /api/v1/vehicles/{id}", "request": { "method": "DELETE", "url": "http://localhost:8080/api/v1/vehicles/1" } }
    ]},
    { "name": "08. category-controller", "item": [
      { "name": "GET /api/v1/categories", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/categories" } },
      { "name": "POST /api/v1/categories", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"name\":\"Electrical\", \"description\":\"Bulbs, wires\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/categories" } },
      { "name": "GET /api/v1/categories/{id}", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/categories/1" } },
      { "name": "PUT /api/v1/categories/{id}", "request": { "method": "PUT", "body": { "mode": "raw", "raw": "{\"name\":\"Updated Name\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/categories/1" } },
      { "name": "DELETE /api/v1/categories/{id}", "request": { "method": "DELETE", "url": "http://localhost:8080/api/v1/categories/1" } }
    ]},
    { "name": "09. review-controller", "item": [
      { "name": "POST /api/v1/reviews/add", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"partId\":1, \"rating\":5, \"comment\":\"Great!\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/reviews/add" } },
      { "name": "GET /api/v1/reviews/part/{partId}", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/reviews/part/1" } }
    ]},
    { "name": "10. payment-controller", "item": [
      { "name": "POST /api/v1/payments/initiate/{orderId}", "request": { "method": "POST", "url": "http://localhost:8080/api/v1/payments/initiate/1" } },
      { "name": "POST /api/v1/payments/confirm", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"transactionId\":\"TX-123\", \"status\":\"PAID\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/payments/confirm" } }
    ]},
    { "name": "11. part-controller", "item": [
      { "name": "GET /api/v1/parts", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/parts" } },
      { "name": "POST /api/v1/parts", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"name\":\"Brake Pad\", \"sku\":\"BP-01\", \"price\":50.0}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8080/api/v1/parts" } },
      { "name": "GET /api/v1/parts/search", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/parts/search?query=Brake" } },
      { "name": "GET /api/v1/parts/category/{categoryId}", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/parts/category/1" } },
      { "name": "GET /api/v1/parts/{id}", "request": { "method": "GET", "url": "http://localhost:8080/api/v1/parts/1" } },
      { "name": "DELETE /api/v1/parts/{id}", "request": { "method": "DELETE", "url": "http://localhost:8080/api/v1/parts/1" } }
    ]}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "jwt_token", "value": "" }
  ]
}