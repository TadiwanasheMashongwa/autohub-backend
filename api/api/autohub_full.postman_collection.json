{
  "info": {
    "name": "AutoHub Full API v1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"tester@autohub.com\",\n    \"password\": \"SecurePassword123!\",\n    \"firstName\": \"Dom\",\n    \"lastName\": \"Tester\",\n    \"phoneNumber\": \"1234567890\",\n    \"businessName\": \"AutoHub Parts Shop\",\n    \"address\": \"456 Spare Parts Blvd\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "http://localhost:8080/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) pm.environment.set(\"token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"tester@autohub.com\",\n    \"password\": \"SecurePassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "http://localhost:8080/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Customer Commerce",
      "item": [
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "http://localhost:8080/api/cart/add?partId=1&quantity=5",
              "query": [
                { "key": "partId", "value": "1" },
                { "key": "quantity", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Hardened Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "checkout-key-{{$guid}}" }
            ],
            "url": "http://localhost:8080/api/orders/checkout"
          }
        }
      ]
    },
    {
      "name": "3. Admin Dashboard",
      "item": [
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "http://localhost:8080/api/admin/dashboard/stats"
          }
        },
        {
          "name": "Low Stock Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "http://localhost:8080/api/admin/dashboard/low-stock"
          }
        },
        {
          "name": "Adjust Stock",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "http://localhost:8080/api/admin/dashboard/inventory/1/stock?quantity=50",
              "query": [{ "key": "quantity", "value": "50" }]
            }
          }
        }
      ]
    }
  ]
}