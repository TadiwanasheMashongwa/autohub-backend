{
  "info": {
    "name": "AutoHub API v1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"tester@autohub.com\",\n    \"password\": \"SecurePassword123!\",\n    \"firstName\": \"Dom\",\n    \"lastName\": \"Tester\",\n    \"phoneNumber\": \"1234567890\",\n    \"businessName\": \"AutoHub Parts Shop\",\n    \"address\": \"456 Spare Parts Blvd\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "http://localhost:8080/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"tester@autohub.com\",\n    \"password\": \"SecurePassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "http://localhost:8080/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get My Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "http://localhost:8080/api/cart"
          }
        },
        {
          "name": "Checkout (Idempotent)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Idempotency-Key", "value": "req-uuid-12345", "type": "text" }
            ],
            "url": "http://localhost:8080/api/cart/checkout"
          }
        }
      ]
    }
  ]
}